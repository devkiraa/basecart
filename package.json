{
  "name": "basecart-root",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean:next": "node -e \"['merchant-dashboard','marketing','storefront','admin-panel','status-page'].forEach(p => { try{fs.rmSync('packages/'+p+'/.next',{recursive:true,force:true})}catch(e){} })\"",
    "predev": "npm run clean:next",
    "dev": "concurrently -n \"marketing,backend,merchant,storefront,admin,status\" -c \"cyan,magenta,blue,green,yellow,red\" \"npm run dev:marketing\" \"npm run dev:backend\" \"npm run dev:merchant\" \"npm run dev:storefront\" \"npm run dev:admin\" \"npm run dev:status\"",
    "dev:marketing": "npm run dev --workspace=packages/marketing",
    "dev:backend": "npm run dev --workspace=packages/backend",
    "dev:merchant": "npm run dev --workspace=packages/merchant-dashboard",
    "dev:storefront": "npm run dev --workspace=packages/storefront",
    "dev:admin": "npm run dev --workspace=packages/admin-panel",
    "dev:status": "npm run dev --workspace=packages/status-page",
    "build:backend": "npm run build --workspace=packages/backend",
    "deploy:backend": "npm run deploy --workspace=packages/backend",
    "build:storefront": "npm run build:shared && npx @cloudflare/next-on-pages --cwd packages/storefront",
    "build:shared": "npm run build --workspace=packages/shared && npm run build --workspace=packages/theme-sdk && npm run build --workspace=packages/theme-engine && npm run build --workspace=packages/emails",
    "build:emails": "npm run build --workspace=packages/emails",
    "build:admin": "npm run build --workspace=packages/admin-panel",
    "test:backend": "npm run test --workspace=packages/backend",
    "localstack:up": "docker compose up -d",
    "localstack:down": "docker compose down",
    "migrate:dev": "npm run migrate:dev --workspace=packages/backend",
    "migrate:dev:remote": "npm run migrate:dev:remote --workspace=packages/backend",
    "migrate:staging": "npm run migrate:staging --workspace=packages/backend",
    "migrate:prod": "npm run migrate:prod --workspace=packages/backend",
    "db:sync": "npm run db:sync --workspace=packages/backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  },
  "overrides": {
    "next": "^14.2.25",
    "shell-quote": "^1.8.2"
  }
}
