{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "types": ["@cloudflare/workers-types"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@basecart/theme-engine": ["../theme-engine/dist/index.d.ts"],
      "@basecart/theme-sdk": ["../theme-sdk/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["src/tests/**/*", "src/local.ts"]
}
