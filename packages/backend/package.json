{
  "name": "@basecart/backend",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "wrangler d1 migrations apply basecart-control-prod --local && wrangler dev --port 3001 --ip 0.0.0.0",
    "bootstrap": "ts-node src/scripts/bootstrap.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:dev": "wrangler d1 migrations apply basecart-control-dev --local --env dev",
    "migrate:dev:remote": "wrangler d1 migrations apply basecart-control-dev --remote --env dev",
    "migrate:staging": "wrangler d1 migrations apply basecart-control-staging --remote --env staging",
    "migrate:prod": "wrangler d1 migrations apply basecart-control-prod --remote"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1086.0",
    "@aws-sdk/client-kms": "^3.1086.0",
    "@aws-sdk/client-s3": "^3.1086.0",
    "@aws-sdk/client-ses": "^3.1086.0",
    "@aws-sdk/client-sqs": "^3.1086.0",
    "@aws-sdk/lib-dynamodb": "^3.1086.0",
    "@aws-sdk/s3-request-presigner": "^3.1086.0",
    "@basecart/emails": "*",
    "@basecart/shared": "*",
    "@basecart/theme-engine": "*",
    "@basecart/theme-sdk": "*",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "hono": "^4.4.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.19.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.4",
    "@cloudflare/workers-types": "^4.20240529.0",
    "@types/aws-lambda": "^8.10.162",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.19",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.2",
    "vitest": "^4.1.10"
  }
}
