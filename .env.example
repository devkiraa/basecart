# ==============================================================================
# Basecart Workspace Environment Variables & Secrets Reference
# ==============================================================================
#
# This file serves as a template for configuring local development.
# Copy this file to '.env' at the workspace root and '.dev.vars' in 'packages/backend'.
#
# ⚠️ SECURITY RULE: Never check actual credentials (keys, tokens, passwords) into Git.
#
# - Local Dev: Controlled by '.env' (for Next.js frontends) and '.dev.vars' (for backend Workers).
# - Production: Controlled securely via Cloudflare Secrets (Dashboard or Wrangler CLI).
#
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Next.js Frontend Configuration (.env)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3001

# Public Gateway URLs
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
NEXT_PUBLIC_MERCHANT_DASHBOARD_URL=http://localhost:3004

# ------------------------------------------------------------------------------
# 2. Local Worker Secrets & Bindings (.dev.vars)
# Copy these to `packages/backend/.dev.vars` for local wrangler testing.
# ------------------------------------------------------------------------------
JWT_SECRET=local_jwt_secret_key_for_testing_purposes
ENCRYPTION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Local Mock Gateways
RAZORPAY_KEY_ID=rzp_test_mock_key
RAZORPAY_KEY_SECRET=rzp_test_mock_secret
SHIPROCKET_WEBHOOK_TOKEN=mock_shiprocket_token

# ZeptoMail Integrations (Local Sandbox)
ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email
ZEPTOMAIL_TOKEN=mock_zeptomail_key

# ------------------------------------------------------------------------------
# 3. Production Secrets (Cloudflare Secrets)
# In production, these are configured securely on Cloudflare:
# Run: npx wrangler secret put <KEY> --env production
#
# - JWT_SECRET: Strong crypto-random key (e.g. openssl rand -hex 64)
# - ENCRYPTION_SECRET: 64-character hex key for merchant credential storage
# - RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET: Production merchant Razorpay credentials
# - ZEPTOMAIL_TOKEN: Production ZeptoMail SMTP/API transactional mail token
# ------------------------------------------------------------------------------
